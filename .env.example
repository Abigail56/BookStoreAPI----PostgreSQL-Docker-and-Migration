# Copy this file to .env and fill in real values before running.
# .env is read by app/database.py and docker-compose.yml (env_file) —
# do not commit the real .env file.

# Postgres connection used by the FastAPI app
DATABASE_URL=postgresql+psycopg://bookstore:bookstore@localhost:5432/bookstore

# Postgres connection used by docker-compose to boot the db container
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore
POSTGRES_DB=bookstore

# Session cookie lifetime, in seconds
SESSION_MAX_AGE=86400
